<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.ExperimentalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:models="clr-namespace:Bloxstrap.UI.ViewModels"
      xmlns:dmodels="clr-namespace:Bloxstrap.UI.ViewModels.Settings"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:Bloxstrap.Resources"
      xmlns:controls="clr-namespace:Bloxstrap.UI.Elements.Controls"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:ExperimentalViewModel, IsDesignTimeCreatable=True}"
      d:DesignHeight="800" d:DesignWidth="800"
      Title="ExperimentalPage"
      Scrollable="True">
    <StackPanel Margin="0,0,14,14">
        <TextBlock Margin="0,0,0,16" Text="Fitur experimental yang sedang dikembangkan." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <controls:OptionControl 
            Header="System Tray saat Roblox ditutup" 
            Description="Saat kamu keluar dari Roblox (klik tombol X), BoneFish tidak akan keluar tapi minimize ke System Tray Windows.">
            <ui:ToggleSwitch IsChecked="{Binding EnableSystemTrayOnClose, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Header="Notifikasi Roblox Native Windows" 
            Description="Aktifkan notifikasi Windows native untuk menampilkan notifikasi dari Roblox di pojok bawah kanan.">
            <ui:ToggleSwitch IsChecked="{Binding EnableRobloxNotifications, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Header="Notifikasi Teman Online" 
            Description="Tampilkan notifikasi ketika teman mu ada yang online. Notifikasi akan muncul di pojok bawah kanan layar.">
            <ui:ToggleSwitch IsChecked="{Binding EnableFriendOnlineNotifications, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Header="Suara Notifikasi" 
            Description="Putar suara saat notifikasi datang.">
            <ui:ToggleSwitch IsChecked="{Binding EnableNotificationSound, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Header="FPS Monitor Overlay" 
            Description="Tampilkan monitor FPS real-time di pojok layar saat bermain Roblox. Klik dan drag untuk memindahkan posisi.">
            <ui:ToggleSwitch IsChecked="{Binding EnableFpsMonitor, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Header="Optimalkan untuk perangkat low-end (Rendah)" 
            Description="Kurangi frekuensi update dan beban CPU agar fitur lebih ringan di laptop jadul. Recommended untuk perangkat kentang.">
            <ui:ToggleSwitch IsChecked="{Binding OptimizeForLowEnd, Mode=TwoWay}" />
        </controls:OptionControl>

    </StackPanel>
</ui:UiPage>
