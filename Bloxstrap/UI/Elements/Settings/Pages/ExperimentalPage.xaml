<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.ExperimentalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:models="clr-namespace:Bloxstrap.UI.ViewModels"
      xmlns:dmodels="clr-namespace:Bloxstrap.UI.ViewModels.Settings"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:Bloxstrap.Resources"
      xmlns:controls="clr-namespace:Bloxstrap.UI.Elements.Controls"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:ExperimentalViewModel, IsDesignTimeCreatable=True}"
      d:DesignHeight="800" d:DesignWidth="800"
      Title="ExperimentalPage"
      Scrollable="True"
      TextElement.FontFamily="{StaticResource JetBrainsMonoRegular}">
    <ui:UiPage.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </ui:UiPage.Resources>

    <!-- ★ FIX 3+4: Background selalu aktif, layout 2 kolom -->
    <Grid Margin="0,0,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Loading Indicator untuk wallpaper -->
        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,0"
                     Visibility="{Binding IsBackgroundLoading, Converter={StaticResource BooleanToVisibilityConverter}}" Grid.Row="0" />

        <TextBlock Grid.Row="0" Margin="0,0,0,12" Text="Fitur experimental yang sedang dikembangkan."
                   FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <!-- ═══ 2 KOLOM UTAMA ════════════════════════════════════════ -->
        <!-- ★ FIX 4: Responsive — 2 kolom, fallback 1 kolom (stacking) kalo < 700px -->
        <Grid Grid.Row="1" Margin="0,0,0,8" SizeChanged="MainGrid_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ── KOLOM KIRI ───────────────────────────────────────── -->
            <StackPanel x:Name="LeftPanel" Grid.Column="0" Grid.Row="0">
                <!-- ❖ GLOBAL HOTKEYS ❖ -->
                <TextBlock Text="Global Hotkeys" FontSize="20" FontWeight="Medium" Margin="0,0,0,0" />
                <TextBlock Text="Gunakan keyboard shortcut untuk toggle fitur dengan cepat saat bermain."
                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />

                <controls:OptionControl 
                    Header="Aktifkan Global Hotkeys" 
                    Description="Izinkan penggunaan keyboard shortcut untuk mengontrol fitur BoneFish.">
                    <ui:ToggleSwitch IsChecked="{Binding EnableHotkeys, Mode=TwoWay}" />
                </controls:OptionControl>

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8">⌨️ Daftar Hotkey</TextBlock>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl + Shift + C" FontWeight="Bold" FontFamily="{StaticResource JetBrainsMonoMedium}" FontSize="13" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Toggle Crosshair Overlay" Margin="10,0,0,4" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl + Shift + F" FontWeight="Bold" FontFamily="{StaticResource JetBrainsMonoMedium}" FontSize="13" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Toggle FPS Monitor" Margin="10,0,0,4" />

                            <!-- Ctrl+Shift+N = Night Vision — DIHAPUS (GAP 4) -->
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ❖ SYSTEM TRAY & NOTIF ❖ -->
                <controls:OptionControl 
                    Header="System Tray saat Roblox ditutup" 
                    Description="Saat kamu keluar dari Roblox, BoneFish minimize ke System Tray.">
                    <ui:ToggleSwitch IsChecked="{Binding EnableSystemTrayOnClose, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl 
                    Header="Notifikasi Roblox Native Windows" 
                    Description="Tampilkan notifikasi Windows dari Roblox di pojok bawah kanan.">
                    <ui:ToggleSwitch IsChecked="{Binding EnableRobloxNotifications, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl 
                    Header="Notifikasi Teman Online" 
                    Description="Tampilkan notifikasi ketika teman online.">
                    <ui:ToggleSwitch IsChecked="{Binding EnableFriendOnlineNotifications, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl 
                    Header="Suara Notifikasi" 
                    Description="Putar suara saat notifikasi datang.">
                    <ui:ToggleSwitch IsChecked="{Binding EnableNotificationSound, Mode=TwoWay}" />
                </controls:OptionControl>

                <!-- ❖ FPS MONITOR ❖ -->
                <controls:OptionControl 
                    Header="FPS Monitor Overlay" 
                    Description="Tampilkan monitor FPS real-time saat bermain Roblox.">
                    <ui:ToggleSwitch IsChecked="{Binding EnableFpsMonitor, Mode=TwoWay}" />
                </controls:OptionControl>

                <Border Visibility="{Binding FpsAdminInfoVisibility}" 
                        Background="{DynamicResource ControlFillColorDefaultBrush}" 
                        CornerRadius="8" Padding="12" Margin="0,0,0,8"
                        BorderBrush="{DynamicResource SystemControlForegroundAccentBrush}"
                        BorderThickness="1">
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="💡 Overlay FPS kustom hanya muncul jika BoneFish dijalankan sebagai "/>
                        <Bold Foreground="{DynamicResource TextFillColorPrimaryBrush}"><Run Text="Administrator"/></Bold>
                        <Run Text=". Jika tidak ingin pakai admin, tekan "/>
                        <Bold Foreground="{DynamicResource TextFillColorPrimaryBrush}"><Run Text="Shift+F5"/></Bold>
                        <Run Text=" di dalam game untuk FPS bawaan Roblox."/>
                    </TextBlock>
                </Border>

                <controls:OptionControl 
                    Header="Optimalkan untuk perangkat low-end" 
                    Description="Kurangi frekuensi update dan beban CPU agar fitur lebih ringan di laptop jadul.">
                    <ui:ToggleSwitch IsChecked="{Binding OptimizeForLowEnd, Mode=TwoWay}" />
                </controls:OptionControl>
            </StackPanel>

            <!-- ── KOLOM KANAN ──────────────────────────────────────── -->
            <StackPanel x:Name="RightPanel" Grid.Column="2" Grid.Row="0">
                <!-- ❖ CROSSHAIR ❖ -->
                <TextBlock Text="Crosshair Overlay" FontSize="20" FontWeight="Medium" Margin="0,0,0,0" />
                <TextBlock Text="Tampilkan crosshair di tengah layar — berguna untuk game FPS tanpa crosshair bawaan."
                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />

                <controls:OptionControl 
                    Header="Aktifkan Crosshair" 
                    Description="Tampilkan crosshair overlay transparan di tengah layar. Drag untuk memindahkan posisi.">
                    <ui:ToggleSwitch IsChecked="{Binding EnableCrosshair, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl 
                    Header="Bentuk Crosshair" 
                    Description="Pilih bentuk crosshair yang diinginkan.">
                    <ComboBox SelectedItem="{Binding CrosshairStyle, Mode=TwoWay}" ItemsSource="{Binding CrosshairStyles}" MinWidth="140" />
                </controls:OptionControl>

                <controls:OptionControl 
                    Header="Ukuran Crosshair" 
                    Description="Atur besar kecil crosshair (20 - 200px).">
                    <Slider Minimum="20" Maximum="200" Value="{Binding CrosshairSize, Mode=TwoWay}" Width="180" TickFrequency="10" IsSnapToTickEnabled="True" />
                </controls:OptionControl>

                <controls:OptionControl 
                    Header="Opacity Crosshair" 
                    Description="Atur transparansi crosshair (0.1 = hampir transparan, 1.0 = solid).">
                    <Slider Minimum="0.1" Maximum="1.0" Value="{Binding CrosshairOpacity, Mode=TwoWay}" Width="180" TickFrequency="0.1" IsSnapToTickEnabled="True" />
                </controls:OptionControl>

                <!-- ═══ CROSSHAIR PREVIEW (FIX 1.4) ═══ -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        CornerRadius="8" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6">🎯 Preview Crosshair</TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <!-- Preview lingkaran kecil dengan warna crosshair saat ini -->
                            <Border Width="48" Height="48" CornerRadius="24"
                                    Background="{Binding CrosshairColor}"
                                    Opacity="{Binding CrosshairOpacity}"
                                    BorderBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                    BorderThickness="2"
                                    Margin="0,0,12,0"
                                    HorizontalAlignment="Left">
                                <Viewbox Width="28" Height="28">
                                    <TextBlock Text="{Binding CrosshairStyle}" 
                                               FontSize="10" 
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="White"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center" />
                                </Viewbox>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="Style: " /><Run FontWeight="Bold" Text="{Binding CrosshairStyle}" />
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="Size: " /><Run FontWeight="Bold" Text="{Binding CrosshairSize, StringFormat='{}{0:0}px'}" />
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="Opacity: " /><Run FontWeight="Bold" Text="{Binding CrosshairOpacity, StringFormat='{}{0:0%}'}" />
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="Color: " /><Run FontWeight="Bold" Text="{Binding CrosshairColor}" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <controls:OptionControl 
                    Header="Warna Crosshair" 
                    Description="Pilih warna crosshair yang kontras dengan background game.">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="28" Height="28" CornerRadius="14" Background="#00FF00" Margin="0,0,6,0" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding SelectCrosshairColorCommand}" CommandParameter="#00FF00" />
                            </Border.InputBindings>
                        </Border>
                        <Border Width="28" Height="28" CornerRadius="14" Background="#FF0000" Margin="0,0,6,0" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding SelectCrosshairColorCommand}" CommandParameter="#FF0000" />
                            </Border.InputBindings>
                        </Border>
                        <Border Width="28" Height="28" CornerRadius="14" Background="#FFFFFF" Margin="0,0,6,0" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding SelectCrosshairColorCommand}" CommandParameter="#FFFFFF" />
                            </Border.InputBindings>
                        </Border>
                        <Border Width="28" Height="28" CornerRadius="14" Background="#00FFFF" Margin="0,0,6,0" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding SelectCrosshairColorCommand}" CommandParameter="#00FFFF" />
                            </Border.InputBindings>
                        </Border>
                        <Border Width="28" Height="28" CornerRadius="14" Background="#FFFF00" Margin="0,0,6,0" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding SelectCrosshairColorCommand}" CommandParameter="#FFFF00" />
                            </Border.InputBindings>
                        </Border>
                        <Border Width="28" Height="28" CornerRadius="14" Background="#FF00FF" Margin="0,0,6,0" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding SelectCrosshairColorCommand}" CommandParameter="#FF00FF" />
                            </Border.InputBindings>
                        </Border>
                        <Border Width="28" Height="28" CornerRadius="14" Background="#FF8800" Margin="0,0,6,0" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding SelectCrosshairColorCommand}" CommandParameter="#FF8800" />
                            </Border.InputBindings>
                        </Border>
                        <Border Width="28" Height="28" CornerRadius="14" Background="#888888" Margin="0,0,6,0" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding SelectCrosshairColorCommand}" CommandParameter="#888888" />
                            </Border.InputBindings>
                        </Border>
                    </StackPanel>
                </controls:OptionControl>

                <!-- ❖ TURBO MODE ❖ -->
                <controls:OptionControl 
                    Header="🚀 Turbo Mode" 
                    Description="Override semua setting ke performa maksimal — cocok untuk FPS darurat. Persisten (tidak auto-reset).">
                    <ui:ToggleSwitch IsChecked="{Binding EnableTurboMode, Mode=TwoWay}" />
                </controls:OptionControl>

                <!-- ❖ WALLPAPER ❖ -->
                <TextBlock Text="Wallpaper Background" FontSize="20" FontWeight="Medium" Margin="0,24,0,0" />
                <TextBlock Text="Wallpaper aesthetic di background semua halaman Settings."
                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />

                <!-- ★ FIX 3: Toggle "Aktifkan Wallpaper" DIHAPUS — background selalu aktif -->

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8">🖼️ Pilih Wallpaper</TextBlock>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Default" VerticalAlignment="Center" Margin="0,0,0,4" />
                            <ui:Button Grid.Row="0" Grid.Column="1" Content="Pilih" Command="{Binding SelectWallpaperDefaultCommand}" Margin="0,0,0,4" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Cool" VerticalAlignment="Center" Margin="0,0,0,4" />
                            <ui:Button Grid.Row="1" Grid.Column="1" Content="Pilih" Command="{Binding SelectWallpaperCoolCommand}" Margin="0,0,0,4" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Quality" VerticalAlignment="Center" Margin="0,0,0,4" />
                            <ui:Button Grid.Row="2" Grid.Column="1" Content="Pilih" Command="{Binding SelectWallpaperQualityCommand}" Margin="0,0,0,4" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Extra" VerticalAlignment="Center" />
                            <ui:Button Grid.Row="3" Grid.Column="1" Content="Pilih" Command="{Binding SelectWallpaperExtraCommand}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Custom" VerticalAlignment="Center" Margin="0,8,0,4" />
                            <ui:Button Grid.Row="4" Grid.Column="1" Content="Browse..." Command="{Binding BrowseCustomBackgroundCommand}" Margin="0,8,0,4" />
                        </Grid>
                    </StackPanel>
                </Border>

                <controls:OptionControl 
                    Header="Mode Random" 
                    Description="Ganti background otomatis setiap kali aplikasi dibuka. Matikan untuk pakai background tetap.">
                    <ui:ToggleSwitch IsChecked="{Binding BackgroundRandomMode, Mode=TwoWay}" />
                </controls:OptionControl>

                <!-- Battery Saver — HANYA muncul di laptop -->
                <controls:OptionControl 
                    Header="Hemat Baterai (Auto-Wallpaper)"
                    Description="Jika laptop tidak dicharge, jangan ganti wallpaper otomatis untuk hemat daya."
                    Visibility="{Binding HasBattery, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:ToggleSwitch IsChecked="{Binding EnableBatterySaverForWallpaper, Mode=TwoWay}" />
                </controls:OptionControl>
            </StackPanel>
        </Grid>

        <!-- ═══ SECTION BAWAH (FULL WIDTH) ════════════════════════════ -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="Cache &amp; Storage" FontSize="20" FontWeight="Medium" Margin="0,8,0,0" />
            <TextBlock Text="Pengaturan penyimpanan cache Roblox." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />

            <controls:OptionControl 
                Header="Bersihkan cache otomatis"
                Description="Bersihkan file cache Roblox yang sudah tua (&gt;14 hari) setiap kali aplikasi dibuka. Aman untuk HDD dan SSD.">
                <ui:ToggleSwitch IsChecked="{Binding EnableAutoCacheCleanup, Mode=TwoWay}" />
            </controls:OptionControl>
        </StackPanel>
    </Grid>
</ui:UiPage>
