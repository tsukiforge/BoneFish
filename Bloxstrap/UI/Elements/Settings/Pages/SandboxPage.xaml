<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.SandboxPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:models="clr-namespace:Bloxstrap.UI.ViewModels.Settings"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance models:SandboxViewModel, IsDesignTimeCreatable=True}"
      d:DesignHeight="1200" d:DesignWidth="800"
      Title="SandboxPage"
      Scrollable="True"
      Loaded="Page_Loaded"
      TextElement.FontFamily="{StaticResource JetBrainsMonoRegular}">
    <ui:UiPage.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ui:UiPage.Resources>

    <Grid Margin="0,0,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:Snackbar Grid.Row="0" x:Name="SandboxSnackbar" Title="Optimization Sandbox" Message=""
                     Appearance="Success" Icon="CheckmarkCircle32" Timeout="5000"
                     Margin="0,0,0,8" Visibility="Collapsed" />

        <!-- ═══ HEADER ═══════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Optimization Sandbox" FontSize="20" FontWeight="Medium" />
                <TextBlock Margin="0,2,0,0" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Temporary optimization test: change Roblox FastFlags safely, back them up first, and keep or roll back afterwards. Fully reversible."
                           TextWrapping="Wrap" />
            </StackPanel>
            <ui:Button Grid.Column="1" Content="New Experiment" Icon="BeakerEdit24"
                       Command="{Binding NewExperimentCommand}" VerticalAlignment="Top" />
        </Grid>

        <!-- ═══ WORKFLOW STEPS ════════════════════════════════════════ -->
        <Border Grid.Row="1" Margin="0,0,0,8" Padding="12,10" CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                Visibility="{Binding StepsVisible, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding WorkflowSteps}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="22" CornerRadius="11" VerticalAlignment="Center" BorderThickness="1.5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="#808080" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StepState}" Value="Done">
                                                <Setter Property="Background" Value="#2E7D32" />
                                                <Setter Property="BorderBrush" Value="#2E7D32" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StepState}" Value="Active">
                                                <Setter Property="Background" Value="#1976D2" />
                                                <Setter Property="BorderBrush" Value="#1976D2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"
                                           Foreground="White" Text="{Binding Marker}" />
                            </Border>
                            <TextBlock Text="{Binding Label}" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Normal" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StepState}" Value="Active">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StepState}" Value="Done">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="→" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- ═══ RECOVERY / WARNINGS ═══════════════════════════════════ -->
        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <ui:InfoBar Margin="0,0,0,8" Padding="8" IsOpen="{Binding RecoveryBannerVisible}"
                        Title="⚠ Unfinished Optimization Experiment" Message="{Binding RecoveryBannerText}"
                        Severity="Warning" IsClosable="False" />

            <ui:InfoBar Margin="0,0,0,8" Padding="8" IsOpen="{Binding IsRobloxRunning}"
                        Title="🟡 Roblox is currently running"
                        Message="These changes will take effect the next time Roblox starts. BoneFish will not close Roblox automatically."
                        Severity="Warning" IsClosable="False" />

            <ui:InfoBar Margin="0,0,0,8" Padding="8" IsOpen="{Binding RobloxNotRunningBannerVisible}"
                        Title="🟢 Roblox is not running"
                        Message="The experiment can be applied now."
                        Severity="Success" IsClosable="False" />

            <!-- Busy indicator -->
            <Border Margin="0,0,0,8" Padding="12,8" CornerRadius="6" Background="#1A2196F3"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13"
                               Foreground="#2196F3" Text="{Binding BusyText}" />
                </StackPanel>
            </Border>

            <ui:InfoBar Margin="0,0,0,8" Padding="8" IsOpen="{Binding HasError}"
                        Title="Experiment error" Message="{Binding ErrorText}"
                        Severity="Error" IsClosable="False" />
        </StackPanel>

        <!-- ═══ EXPERIMENT EDITOR ═════════════════════════════════════ -->
        <Border Grid.Row="3" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding ExperimentTitle}" VerticalAlignment="Center" />
                    <Border Margin="8,0,0,0" Padding="6,2" Background="#37474F" CornerRadius="4">
                        <TextBlock FontSize="10" FontWeight="Bold" Foreground="#B0BEC5" Text="{Binding StateText}" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" IsEnabled="{Binding CanEditChanges}">
                    <TextBlock Text="Base Profile" FontSize="13" VerticalAlignment="Center" />
                    <ComboBox Width="180" Margin="8,0,0,0" Padding="10,5,10,5"
                              ItemsSource="{Binding BaseProfiles}"
                              SelectedItem="{Binding SelectedBaseProfile}" />
                </StackPanel>
                <TextBlock Margin="8,4,0,0" FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="Starting configuration for this experiment. Your saved profile is not changed until you commit the experiment."
                           TextWrapping="Wrap" />

                <TextBlock Margin="0,12,0,4" FontSize="13" FontWeight="SemiBold" Text="Configuration Changes" />
                <TextBlock Margin="0,0,0,6" FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="Leave the new value empty to remove a flag. Only Roblox FastFlags can be modified." />

                <ItemsControl ItemsSource="{Binding Changes}" IsEnabled="{Binding CanEditChanges}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0" Text="{Binding FlagName, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="FlagName" />
                                <ui:TextBox Grid.Column="2" Text="{Binding CurrentValue}" IsReadOnly="True"
                                            PlaceholderText="current" />
                                <ui:TextBox Grid.Column="4" Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="new value" />
                                <ui:Button Grid.Column="6" Icon="Delete16" ToolTip="Remove change"
                                           Command="{Binding DataContext.RemoveChangeCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}"
                                           CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ui:Button Margin="0,8,0,0" Content="+ Add change" Icon="Add16"
                           Command="{Binding AddChangeCommand}" IsEnabled="{Binding CanEditChanges}" />
            </StackPanel>
        </Border>

        <!-- ═══ DIFF PREVIEW ══════════════════════════════════════════ -->
        <Border Grid.Row="4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock FontSize="14" FontWeight="SemiBold" Text="Changes that will be applied" />
                <TextBlock Margin="0,2,0,0" FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="Only these values will be changed. Unchanged flags are left untouched."
                           TextWrapping="Wrap" />

                <TextBlock Margin="0,8,0,0" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="No changes yet. Add a FastFlag to begin the experiment."
                           Visibility="{Binding NoChangesPlaceholderVisible, Converter={StaticResource BoolToVis}}" />

                <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding DiffPreview}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontWeight="Bold" Text="{Binding Marker}" Foreground="{Binding MarkerBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding FlagName}" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="2" Text="{Binding Description}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="#FF9800" TextWrapping="Wrap"
                           Text="{Binding DuplicateWarningText}" />
            </StackPanel>
        </Border>

        <!-- ═══ STATUS ════════════════════════════════════════════════ -->
        <Border Grid.Row="5" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,8">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="BACKUP (SNAPSHOT)" />
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Backup before testing" />
                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding SnapshotStatusText}" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="EXPERIMENT STATUS" />
                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding StateText}" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="ROBLOX" />
                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding RobloxStatusText}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <TextBlock FontSize="12" Text="{Binding StatusChecklistText}" Margin="0,10,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                <Separator Margin="0,12" />

                <StackPanel>
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="MEASUREMENTS" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="Before Experiment" />
                            <TextBlock FontSize="12" Text="Average FPS" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding BeforeFpsText}" />
                            <TextBlock FontSize="12" Text="1% Low" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding BeforeP1LowText}" />
                            <TextBlock FontSize="12" Text="RAM" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding BeforeRamText}" />
                            <TextBlock FontSize="12" Text="CPU" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding BeforeCpuText}" />
                            <TextBlock FontSize="12" Text="GPU" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding BeforeGpuText}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="After Experiment" />
                            <TextBlock FontSize="12" Text="Average FPS" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding AfterFpsText}" />
                            <TextBlock FontSize="12" Text="1% Low" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding AfterP1LowText}" />
                            <TextBlock FontSize="12" Text="RAM" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding AfterRamText}" />
                            <TextBlock FontSize="12" Text="CPU" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding AfterCpuText}" />
                            <TextBlock FontSize="12" Text="GPU" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding AfterGpuText}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="Average FPS and 1% Low are sampled automatically while you play (needs Roblox running and ETW telemetry / administrator rights). RAM and CPU are read from the Roblox process and work without administrator rights. GPU has no telemetry source in BoneFish — shown as N/A. Nothing is invented; if automatic sampling is unavailable, record the result manually." />
                    <TextBlock FontSize="13" Text="{Binding ResultText}" Margin="0,6,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══ ACTIONS ════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="6" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <ui:Button Content="Cancel" Icon="Stop24" Margin="0,0,8,0"
                           Command="{Binding CancelCommand}" Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}" />
                <ui:Button Content="Rollback" Icon="ArrowUndo24" Margin="0,0,8,0" Appearance="Danger"
                           ToolTip="Restore the Roblox configuration from before this experiment."
                           Command="{Binding RollbackCommand}" Visibility="{Binding CanRollback, Converter={StaticResource BoolToVis}}" />
                <ui:Button Content="Prepare Experiment" Icon="CheckmarkCircle24" Appearance="Primary"
                           ToolTip="Create a backup of the current Roblox configuration before applying these changes."
                           Command="{Binding PrepareCommand}" Visibility="{Binding CanPrepare, Converter={StaticResource BoolToVis}}" />
                <ui:Button Content="Apply Experiment" Icon="Checkmark24" Appearance="Primary"
                           ToolTip="Apply the backed-up changes to your Roblox configuration."
                           Command="{Binding ApplyCommand}" Visibility="{Binding CanApply, Converter={StaticResource BoolToVis}}" />
                <ui:Button Content="Start Test" Icon="Play24" Margin="0,0,8,0" Appearance="Primary"
                           Command="{Binding StartTestCommand}" Visibility="{Binding CanStartTest, Converter={StaticResource BoolToVis}}" />
                <ui:Button Content="Measure baseline" Icon="Timer24" Margin="0,0,8,0"
                           Command="{Binding MeasureBaselineCommand}" Visibility="{Binding CanMeasure, Converter={StaticResource BoolToVis}}" />
                <ui:Button Content="Measure now" Icon="Camera24" Margin="0,0,8,0"
                           Command="{Binding MeasureNowCommand}" Visibility="{Binding CanMeasure, Converter={StaticResource BoolToVis}}" />
                <ui:Button Content="Record Result (Manual)" Icon="ArrowCircleRight24" Margin="0,0,8,0" Appearance="Primary"
                           ToolTip="Manual test result: mark the test finished — you decide the outcome."
                           Command="{Binding RecordResultCommand}" Visibility="{Binding CanRecordResult, Converter={StaticResource BoolToVis}}" />
                <ui:Button Content="Commit" Icon="Save24" Margin="0,0,8,0" Appearance="Success"
                           ToolTip="Keep these changes and save them to the selected profile."
                           Command="{Binding CommitCommand}" Visibility="{Binding CanCommit, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <TextBlock FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="{Binding ActionHintText}" />

            <TextBlock FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="✓ Experiment finished. Start a new experiment from the header button."
                       Visibility="{Binding IsExperimentFinished, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!-- ═══ HISTORY ════════════════════════════════════════════════ -->
        <Border Grid.Row="7" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="14">
            <StackPanel>
                <TextBlock FontSize="14" FontWeight="SemiBold" Text="Experiment History" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Column="0" ItemsSource="{Binding History}"
                             SelectedItem="{Binding SelectedHistory}"
                             MaxHeight="220">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" />
                                    <TextBlock Text="{Binding FriendlyStateName}" Margin="8,0,0,0" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Column="2" FontSize="12" Text="{Binding HistoryDetailText}"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</ui:UiPage>
