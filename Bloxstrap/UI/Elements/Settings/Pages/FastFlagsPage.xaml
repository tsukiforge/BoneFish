<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.FastFlagsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:models="clr-namespace:Bloxstrap.UI.ViewModels"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:Bloxstrap.Resources"
      xmlns:controls="clr-namespace:Bloxstrap.UI.Elements.Controls"
      mc:Ignorable="d"
      d:DesignHeight="1200" d:DesignWidth="800"
      Title="FastFlagsPage"
      Scrollable="True"
      Loaded="Page_Loaded"
      TextElement.FontFamily="{StaticResource JetBrainsMonoRegular}">
    <ui:UiPage.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ui:UiPage.Resources>

    <!-- ★ FIX 4: Layout 2 kolom untuk mengurangi scroll -->
    <Grid Margin="0,0,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── INFO & LOADING ─────────────────────────────────────── -->
        <TextBlock Grid.Row="0" Margin="0,0,0,12" 
                   Text="{x:Static resources:Strings.Menu_FastFlags_Description}" 
                   FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <ui:Snackbar Grid.Row="0" x:Name="FastFlagsSnackbar" Title="Pemberitahuan" Message="" 
                     Appearance="Success" Icon="CheckmarkCircle32" Timeout="5000" 
                     Margin="0,0,0,8" Visibility="Collapsed" />

        <!-- Loading indicator saat apply preset -->
        <Border Grid.Row="0" x:Name="ApplyingIndicator" Margin="0,0,0,8" Padding="12,8" CornerRadius="6"
                Background="#1A2196F3"
                Visibility="{Binding IsApplying, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13"
                           Foreground="#2196F3" Text="{Binding ApplyingText}" />
            </StackPanel>
        </Border>

        <!-- ═══ 2 KOLOM UTAMA ════════════════════════════════════════ -->
        <!-- ★ FIX 4: Responsive — 2 kolom, fallback 1 kolom (stacking) kalo < 700px -->
        <Grid Grid.Row="2" Margin="0,0,0,12" SizeChanged="MainGrid_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ══ KOLOM KIRI ════════════════════════════════════════ -->
            <StackPanel x:Name="LeftPanel" Grid.Column="0" Grid.Row="0">
                <!-- SYSTEM INFO → ADAPTIVE HARDWARE DASHBOARD (Phase 5) -->
                <!-- Ringan: seluruh isi dirender dari snapshot on-demand (SystemDashboard).
                     Tidak ada timer/polling — refresh HANYA saat page reload atau tombol. -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Text="💻 System Dashboard" VerticalAlignment="Center" />
                                <Border Margin="8,0,0,0" Padding="6,2" Background="#004D40" CornerRadius="4">
                                    <TextBlock FontSize="10" FontWeight="Bold" Foreground="#64FFDA" Text="READ-ONLY" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Diagnostik READ-ONLY (Phase 6) — Diagnostic Center, on-demand -->
                                <ui:Button Padding="8,3" FontSize="11"
                                           Appearance="Secondary"
                                           Content="🔍 Diagnostics"
                                           Command="{Binding ShowPerformanceDiagnosticsCommand}" />
                                <ui:Button Margin="6,0,0,0" Padding="8,3" FontSize="11"
                                           Appearance="Secondary" Icon="ArrowClockwise24"
                                           Content="{x:Static resources:Strings.FastFlags_SystemInfo_RedetectHardware}"
                                           Command="{Binding RefreshHardwareDetectionCommand}" />
                            </StackPanel>
                        </Grid>

                        <!-- DEVICE -->
                        <TextBlock Margin="0,10,0,2" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="DEVICE" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="CPU" />
                            <TextBlock Grid.Row="0" Grid.Column="1" FontSize="12" Text="{Binding SystemDashboard.Cpu}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Grid.Column="0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="RAM" />
                            <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12" Text="{Binding SystemDashboard.Ram}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="2" Grid.Column="0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="GPU" />
                            <TextBlock Grid.Row="2" Grid.Column="1" FontSize="12" Text="{Binding SystemDashboard.Gpu}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="3" Grid.Column="0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Storage" />
                            <TextBlock Grid.Row="3" Grid.Column="1" FontSize="12" Text="{Binding SystemDashboard.Storage}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="4" Grid.Column="0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Display" />
                            <TextBlock Grid.Row="4" Grid.Column="1" FontSize="12" Text="{Binding SystemDashboard.Display}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="5" Grid.Column="0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Windows" />
                            <TextBlock Grid.Row="5" Grid.Column="1" FontSize="12" Text="{Binding SystemDashboard.Os}" TextWrapping="Wrap" />
                        </Grid>

                        <!-- PROFILE -->
                        <TextBlock Margin="0,8,0,2" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="PROFILE" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <Border Padding="6,2" Background="#0D47A1" CornerRadius="4">
                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="#90CAF9" Text="{Binding SystemDashboard.Tier}" />
                            </Border>
                            <TextBlock Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="{Binding SystemDashboard.TierReason}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="{Binding SystemDashboard.PerformanceMode, StringFormat='Performance Mode: {0}'}" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="{Binding SystemDashboard.StorageConfidence, StringFormat='Storage Confidence: {0}'}" />

                        <!-- HEALTH -->
                        <TextBlock Margin="0,8,0,2" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="HEALTH" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="{Binding SystemDashboard.MemoryHealth, StringFormat='• {0}'}" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="{Binding SystemDashboard.RobloxStatus, StringFormat='• Roblox: {0}'}" />
                        <!-- OPTIMIZATION -->
                        <TextBlock Margin="0,8,0,2" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="OPTIMIZATION" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="{Binding SystemDashboard.Preset, StringFormat='• Preset: {0}'}" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="{Binding SystemDashboard.FpsCap, StringFormat='• FPS cap: {0}'}" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="{Binding SystemDashboard.FastLoading, StringFormat='• Fast Loading: {0}'}" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="{Binding SystemDashboard.TdrMitigation, StringFormat='• TDR Mitigation: {0}'}" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="{Binding SystemDashboard.MemoryMode, StringFormat='• Memory: {0}'}" />

                        <!-- SECURITY -->
                        <TextBlock Margin="0,8,0,2" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="SECURITY" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="12" FontWeight="Bold" Text="{Binding SystemDashboard.SecurityState, StringFormat='Windows Security: {0}'}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="LimeGreen" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SystemDashboard.SecurityState}" Value="Degraded">
                                                <Setter Property="Foreground" Value="Orange" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SystemDashboard.SecurityState}" Value="Unknown">
                                                <Setter Property="Foreground" Value="Orange" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="{Binding SystemDashboard.SecurityDetail}" TextWrapping="Wrap" />
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="{Binding SystemDashboard.ProtectedProcessCount, StringFormat='Guard proses keamanan: {0} — security processes can never be suspended'}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <ui:InfoBar MouseDoubleClick="InfoBar_MouseDoubleClick" Margin="0,0,0,0" Padding="8" 
                            Title="{x:Static resources:Strings.Common_Warning}" 
                            Message="{x:Static resources:Strings.Menu_FastFlags_EditorInfo}" 
                            Severity="Warning" IsOpen="True" IsClosable="False" />

                <ui:CardAction Margin="0,8,0,0" Icon="EditSettings24" Command="{Binding OpenFastFlagEditorCommand}">
                    <StackPanel>
                        <TextBlock FontSize="14" Text="{x:Static resources:Strings.Menu_FastFlagEditor_Title}" />
                        <TextBlock Margin="0,2,0,0" FontSize="12" 
                                   Text="{x:Static resources:Strings.Menu_FastFlags_Editor_Description}" 
                                   Padding="0,0,16,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </ui:CardAction>

                <!-- APPLY & RESTART -->
                <ui:CardAction Margin="0,8,0,0" Icon="ArrowSync24" Command="{Binding ApplyAndRestartRobloxCommand}"
                               Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="🚀 Apply &amp; Restart Roblox" />
                            <Border Margin="8,0,0,0" Padding="6,2" Background="#004D40" CornerRadius="4">
                                <TextBlock FontSize="10" FontWeight="Bold" Foreground="#64FFDA" Text="SAVE + RESTART" />
                            </Border>
                        </StackPanel>
                        <TextBlock Margin="0,2,0,0" FontSize="12" Padding="0,0,16,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="Simpan semua FastFlag &amp; perubahan settings ke disk, tutup paksa Roblox, lalu restart BoneFish loader." />
                    </StackPanel>
                </ui:CardAction>

                <!-- PERFORMANCE PRESETS -->
                <TextBlock Text="Performance &amp; Network Presets (Pilih Satu)" FontSize="20" FontWeight="Medium" Margin="0,16,0,4" />

                <ui:CardAction Margin="0,4,0,0" Icon="Settings28" Command="{Binding ApplyRecommendedFastFlagsCommand}">
                    <StackPanel>
                        <TextBlock FontSize="14" Text="Auto-optimize FastFlags" />
                        <TextBlock Margin="0,2,0,0" FontSize="12" Text="Set Roblox's saved graphics quality to low and clear legacy renderer overrides."
                                   Padding="0,0,16,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Margin="0,4,0,0" FontSize="12" FontWeight="Bold" Foreground="LimeGreen" 
                                   Text="[ ACTIVE ]" Visibility="{Binding IsAutoOptimizeActive, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </ui:CardAction>

                <ui:CardAction Margin="0,4,0,0" Icon="Wrench24" Command="{Binding ApplyRecommendedStabilityPresetCommand}">
                    <StackPanel>
                        <TextBlock FontSize="14" Text="Apply stable low-spec preset" />
                        <TextBlock Margin="0,2,0,0" FontSize="12" 
                                   Text="Set Roblox's saved graphics quality to low and clear legacy renderer overrides. Matchmaking preferences do not change ping."
                                   Padding="0,0,16,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Margin="0,4,0,0" FontSize="12" FontWeight="Bold" Foreground="LimeGreen" 
                                   Text="[ ACTIVE ]" Visibility="{Binding IsStableActive, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </ui:CardAction>

                <ui:CardAction Margin="0,4,0,0" Icon="AppsAddIn28" Command="{Binding ApplyBalancedPresetCommand}">
                    <StackPanel>
                        <TextBlock FontSize="14" Text="Balanced" />
                        <TextBlock Margin="0,2,0,0" FontSize="12" Text="Keseimbangan visual dan performa; preferensi matchmaking tidak menurunkan ping."
                                   Padding="0,0,16,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Margin="0,4,0,0" FontSize="12" FontWeight="Bold" Foreground="LimeGreen" 
                                   Text="[ ACTIVE ]" Visibility="{Binding IsBalancedActive, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </ui:CardAction>

                <ui:CardAction Margin="0,4,0,0" Icon="Flash24" Command="{Binding ApplyExtremePerformancePresetCommand}"
                               Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="🥔 Extreme Performance (Potato Mode)" />
                            <Border Margin="8,0,0,0" Padding="6,2" Background="#CC3300" CornerRadius="4">
                                <TextBlock FontSize="10" FontWeight="Bold" Foreground="White" Text="PALING AGRESIF" />
                            </Border>
                        </StackPanel>
                        <TextBlock Margin="0,2,0,0" FontSize="12" Padding="0,0,16,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="Sets Roblox's saved graphics quality to the lowest level and removes legacy renderer overrides. This cannot guarantee that freezes will stop." />
                        <TextBlock Margin="0,4,0,0" FontSize="12" FontWeight="Bold" Foreground="Orange"
                                   Text="[ LOW ROBLOX GRAPHICS ]"
                                   Visibility="{Binding IsExtremePerformanceActive, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </ui:CardAction>

                <!-- CLEAR CLIENTAPPSETTINGS -->
                <ui:CardAction Margin="0,12,0,0" Icon="Delete24" Command="{Binding ClearClientAppSettingsCommand}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="🗑️ Clear ClientAppSettings" />
                            <Border Margin="8,0,0,0" Padding="6,2" Background="#5A3000" CornerRadius="4">
                                <TextBlock FontSize="10" FontWeight="Bold" Foreground="#FFA040" Text="TROUBLESHOOT" />
                            </Border>
                        </StackPanel>
                        <TextBlock Margin="0,2,0,0" FontSize="12" Padding="0,0,16,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="Hapus semua FastFlag dari BoneFish dan Roblox path. Pilih ulang preset setelahnya." />
                    </StackPanel>
                </ui:CardAction>
            </StackPanel>

            <!-- ══ KOLOM KANAN ═══════════════════════════════════════ -->
            <StackPanel x:Name="RightPanel" Grid.Column="2" Grid.Row="0">
                <!-- NIGHT VISION — DIHAPUS (GAP 4: deprecated flags) -->

                <!-- FORCE EXTREME MODE -->
                <controls:OptionControl
                    Header="Force Extreme Mode (Potato Mode Override)"
                    Description="Gunakan kualitas grafis Roblox rendah dan bersihkan renderer FastFlags lama, tanpa memaksa override render eksperimental.">
                    <ui:ToggleSwitch IsChecked="{Binding ForceExtremeMode, Mode=TwoWay}" />
                </controls:OptionControl>

                <!-- FAST LOADING TOGGLE -->
                <controls:OptionControl
                    Header="Fast Loading (Percepat Muncul Aset)"
                    Description="Pada CPU 8+ logical processor menulis thread flag yang penerimaannya belum terverifikasi; Roblox menolak flag texture-compositor pada log yang dianalisis. Tidak menjamin loading lebih cepat.">
                    <ui:ToggleSwitch IsChecked="{Binding EnableFastLoadingFlags, Mode=TwoWay}" />
                </controls:OptionControl>

                <!-- FPS UNLOCKER TOGGLE -->
                <controls:OptionControl
                    Header="{x:Static resources:Strings.Menu_FastFlags_FpsUnlocker_Title}"
                    Description="{Binding FpsUnlockerStatusText}">
                    <ui:ToggleSwitch IsChecked="{Binding FpsUnlockerEnabled, Mode=TwoWay}" />
                </controls:OptionControl>

                <!-- TDR MITIGATION TOGGLE -->
                <controls:OptionControl
                    Header="{x:Static resources:Strings.Menu_FastFlags_TdrMitigation_Title}"
                    Description="{x:Static resources:Strings.Menu_FastFlags_TdrMitigation_Description}">
                    <ui:ToggleSwitch IsChecked="{Binding EnableTdrMitigation, Mode=TwoWay}" />
                </controls:OptionControl>

                <!-- MANUAL OVERRIDES -->
                <TextBlock Text="Manual FastFlag Overrides" FontSize="20" FontWeight="Medium" Margin="0,16,0,4" />

                <controls:OptionControl 
                    Header="{x:Static resources:Strings.Menu_FastFlags_ManagerEnabled_Title}"
                    Description="{x:Static resources:Strings.Menu_FastFlags_ManagerEnabled_Description}">
                    <ui:ToggleSwitch IsChecked="{Binding UseFastFlagManager, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl 
                    Header="{x:Static resources:Strings.Menu_FastFlags_Reset_Title}">
                    <ui:ToggleSwitch IsChecked="{Binding ResetConfiguration, Mode=TwoWay}" />
                </controls:OptionControl>

                <!-- GEOMETRY -->
                <TextBlock Text="{x:Static resources:Strings.Common_Presets}" FontSize="20" FontWeight="Medium" Margin="0,16,0,4" />
                <TextBlock Text="{x:Static resources:Strings.Common_Geometry}" FontSize="16" FontWeight="Medium" Margin="0,4,0,0" />

                <ui:CardExpander Margin="0,4,0,0" IsExpanded="{Binding Path=MeshQualityEnabled, Mode=OneWay}" 
                                 Style="{StaticResource NoUserExpansionCardExpanderStyle}">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock FontSize="14" Text="{x:Static resources:Strings.Menu_FastFlags_MeshDetail_Header}" />
                                <TextBlock FontSize="12" Text="{x:Static resources:Strings.Menu_FastFlags_MeshDetail_Description}" 
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding MeshQualityEnabled, Mode=TwoWay}" />
                        </Grid>
                    </ui:CardExpander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Padding="8" Text="{x:Static resources:Strings.Menu_FastFlags_MeshDetail_LowQualityWarning}" 
                                   TextAlignment="Center" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static resources:Strings.Common_LowestQuality}" Grid.Column="0" />
                            <Slider Grid.Column="1" Margin="8,0,8,0" Minimum="0" Maximum="3" 
                                    TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MeshQuality, Mode=TwoWay}" />
                            <TextBlock Text="{x:Static resources:Strings.Common_HighestQuality}" Grid.Column="2" />
                        </Grid>
                    </StackPanel>
                </ui:CardExpander>

                <!-- RENDERING -->
                <TextBlock Text="{x:Static resources:Strings.Menu_FastFlags_Presets_Categories_Rendering}" 
                           FontSize="16" FontWeight="Medium" Margin="0,16,0,0" />

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_Presets_MSAA_Title}">
                    <ComboBox Margin="5,0,0,0" Padding="10,5,10,5" Width="200" 
                              ItemsSource="{Binding MSAALevels.Keys, Mode=OneTime}" 
                              SelectedItem="{Binding SelectedMSAALevel, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:OptionControl>

                <controls:OptionControl 
                    Header="{x:Static resources:Strings.Menu_FastFlags_Presets_FixDisplayScaling_Title}" 
                    Description="{x:Static resources:Strings.Menu_FastFlags_Presets_FixDisplayScaling_Description}" 
                    HelpLink="https://github.com/bloxstraplabs/bloxstrap/wiki/A-guide-to-FastFlags#dpi-scaling-fixes">
                    <ui:ToggleSwitch IsChecked="{Binding FixDisplayScaling, Mode=TwoWay}" />
                </controls:OptionControl>

                <ui:CardExpander Margin="0,4,0,0" IsExpanded="{Binding FRMQualityOverrideEnabled, Mode=OneWay}" 
                                 Style="{StaticResource NoUserExpansionCardExpanderStyle}">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock FontSize="14" Text="{x:Static resources:Strings.Menu_FastFlags_FRMQualityOverride_Title}" />
                                <TextBlock FontSize="12" Text="{x:Static resources:Strings.Menu_FastFlags_FRMQualityOverride_Description}" 
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding FRMQualityOverrideEnabled, Mode=TwoWay}" />
                        </Grid>
                    </ui:CardExpander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static resources:Strings.Common_LowestQuality}" Grid.Column="0" />
                        <Slider Grid.Column="1" Margin="8,0,8,0" Minimum="1" Maximum="21" 
                                TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FRMQualityOverride, Mode=TwoWay}" />
                        <TextBlock Text="{x:Static resources:Strings.Common_HighestQuality}" Grid.Column="2" />
                        <Border Margin="8,-4,0,0" Grid.Column="3" Width="30" 
                                BorderBrush="{ui:ThemeResource SolidBackgroundFillColorSecondarybrush}" 
                                Background="{ui:ThemeResource SolidBackgroundFillColorSecondarybrush}" 
                                BorderThickness="1" CornerRadius="4">
                            <TextBlock HorizontalAlignment="Center" Padding="4" VerticalAlignment="Center" 
                                       TextAlignment="Center" Text="{Binding FRMQualityOverride, Mode=TwoWay}" />
                        </Border>
                    </Grid>
                </ui:CardExpander>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_Presets_RenderingMode_Title}">
                    <ComboBox Margin="5,0,0,0" Padding="10,5,10,5" Width="200" 
                              ItemsSource="{Binding RenderingModes.Keys, Mode=OneTime}" 
                              SelectedItem="{Binding SelectedRenderingMode, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_Presets_TextureQuality_Title}">
                    <ComboBox Margin="5,0,0,0" Padding="10,5,10,5" Width="200" 
                              ItemsSource="{Binding TextureQualities.Keys, Mode=OneTime}" 
                              SelectedItem="{Binding SelectedTextureQuality, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:OptionControl>
            </StackPanel>
        </Grid>
    </Grid>
</ui:UiPage>
