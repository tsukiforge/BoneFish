<Window x:Class="Bloxstrap.UI.Elements.FpsMonitorOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FPS Monitor"
        Width="150"
        Height="100"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        MouseUp="Window_MouseUp"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">
    <Border Background="#1F1F1F" Opacity="0.85" CornerRadius="10" Margin="5" Padding="10">
        <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock 
                Text="FPS Monitor" 
                Foreground="White" 
                FontSize="12" 
                FontWeight="Bold" 
                HorizontalAlignment="Center" 
                Margin="0,0,0,5"/>
            
            <TextBlock 
                Name="FpsValueText"
                Text="0 FPS" 
                Foreground="#00FF00" 
                FontSize="20" 
                FontWeight="Bold" 
                FontFamily="Courier New"
                HorizontalAlignment="Center" 
                Margin="0,0,0,3"/>
            
            <TextBlock 
                Name="FrameTimeText"
                Text="0.0 ms" 
                Foreground="#FFD700" 
                FontSize="11" 
                FontFamily="Courier New"
                HorizontalAlignment="Center" 
                Margin="0,0,0,3"/>
            
            <TextBlock 
                Name="StatusText"
                Text="Initializing..." 
                Foreground="#87CEEB" 
                FontSize="9" 
                HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
