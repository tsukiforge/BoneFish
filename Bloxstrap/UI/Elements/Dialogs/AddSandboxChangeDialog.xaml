<base:WpfUiWindow x:Class="Bloxstrap.UI.Elements.Dialogs.AddSandboxChangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:Bloxstrap.UI.Elements.Base"
        mc:Ignorable="d"
        Title="Add Configuration Change"
        MinHeight="0"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Padding="8" Title="Add Configuration Change" ShowMinimize="False" ShowMaximize="False" CanMaximize="False" KeyboardNavigation.TabNavigation="None" />

        <StackPanel Grid.Row="1" Margin="16">
            <TextBlock Text="Search FastFlag" FontSize="13" FontWeight="SemiBold" />
            <TextBox x:Name="SearchTextBox" Margin="0,6,0,0" TextChanged="SearchTextBox_TextChanged" />

            <TextBlock Text="Known flags (from your BoneFish FastFlag database)" FontSize="11"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,10,0,2" />
            <ListBox x:Name="FlagsListBox" MaxHeight="150" SelectionChanged="FlagsListBox_SelectionChanged" />

            <TextBlock x:Name="ExistingHintText" FontSize="11" Foreground="#FF9800" Margin="0,6,0,0"
                       Text="This flag is already in the experiment — its entry will be updated."
                       TextWrapping="Wrap" Visibility="Collapsed" />

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Flag" VerticalAlignment="Center" MinWidth="90" Margin="0,0,8,8" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="FlagNameText" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,8" Text="—" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Current value" VerticalAlignment="Center" MinWidth="90" Margin="0,0,8,8" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="CurrentValueTextBox" IsReadOnly="True" Margin="0,0,0,8" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="New value" VerticalAlignment="Center" MinWidth="90" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="NewValueTextBox" TextChanged="NewValueTextBox_TextChanged" />
            </Grid>

            <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="6" Background="#1A1976D2">
                <TextBlock x:Name="PreviewText" FontSize="12" Foreground="#90CAF9" TextWrapping="Wrap"
                           Text="Select a flag to preview the change." />
            </Border>

            <TextBlock x:Name="ErrorText" FontSize="12" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>

        <Border Grid.Row="2" Margin="0,10,0,0" Padding="15" Background="{ui:ThemeResource SolidBackgroundFillColorSecondaryBrush}">
            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Right">
                <Button MinWidth="110" Content="Add Change" Click="AddButton_Click" />
                <Button MinWidth="110" Margin="12,0,0,0" Content="Cancel" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</base:WpfUiWindow>
