<base:WpfUiWindow x:Class="Bloxstrap.UI.Elements.Dialogs.SandboxRecommendationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:Bloxstrap.UI.Elements.Base"
        mc:Ignorable="d"
        Title="Recommended FastFlags for Your Device"
        MinHeight="0"
        Width="620"
        SizeToContent="Height"
        ResizeMode="NoResize"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Padding="8" Title="Recommended FastFlags for Your Device" ShowMinimize="False" ShowMaximize="False" CanMaximize="False" KeyboardNavigation.TabNavigation="None" />

        <StackPanel Grid.Row="1" Margin="16">
            <Border Padding="10,8" CornerRadius="6" Background="#1A1976D2">
                <TextBlock x:Name="SystemInfoText" FontSize="12" Foreground="#90CAF9" TextWrapping="Wrap" />
            </Border>

            <TextBlock Margin="0,10,0,2" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       Text="BoneFish read your device and recommends these changes. Tick the ones you want — unticked flags are left out of the experiment. Nothing is applied until you prepare and apply the experiment." />

            <Grid Margin="0,8,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="12" FontWeight="SemiBold" Text="Suggested changes" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Padding="10,4" Content="Select all" Click="SelectAllButton_Click" />
                    <Button Padding="10,4" Margin="8,0,0,0" Content="None" Click="SelectNoneButton_Click" />
                </StackPanel>
            </Grid>

            <ListBox x:Name="RecommendationsList" MaxHeight="320">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Padding="4">
                            <StackPanel Margin="4,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding FlagName}" />
                                    <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="3" Background="#1A4CAF50">
                                        <TextBlock FontSize="10" Foreground="#4CAF50" Text="RECOMMENDED" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Margin="0,2,0,0" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Description}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="SelectedCountText" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Margin="0,6,0,0" />

            <TextBlock x:Name="ErrorText" FontSize="12" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>

        <Border Grid.Row="2" Margin="0,10,0,0" Padding="15" Background="{ui:ThemeResource SolidBackgroundFillColorSecondaryBrush}">
            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Right">
                <Button MinWidth="120" Content="Add to Experiment" Click="AddButton_Click" />
                <Button MinWidth="110" Margin="12,0,0,0" Content="Cancel" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</base:WpfUiWindow>
